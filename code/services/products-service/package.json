    "express": "^4.18.2",
    "express-list-endpoints": "3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^1.6.1"
  }
}
