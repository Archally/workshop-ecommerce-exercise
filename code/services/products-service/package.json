{
  "name": "products-service",
  "version": "1.0.0",
  "description": "Products service for contract testing POC",
  "main": "dist/server.js",
  "scripts": {
    "generate:type-schemas": "node scripts/generate-type-schemas.mjs",
    "predev": "npm run generate:type-schemas",
    "prebuild": "npm run generate:type-schemas",
    "pretest": "npm run generate:type-schemas",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
